---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PhotoCarousel } from '@/components/PhotoCarousel';
import '@mantine/core/styles.css';
import '@mantine/carousel/styles.css';
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import seatImage from '@/assets/index/seat.png';
import upholsteryImage from '@/assets/index/upholstery.jpg';
import steeringImage from '@/assets/index/steering.jpg';
import roofLiningImage from '@/assets/index/roof-lining.jpg';
import dashboardImage from '@/assets/index/dashboard.jpg';
import businessInNumbersImage from '@/assets/index/business-in-numbers.jpg';
import vanImage from '@/assets/index/van.jpg';
import worksSeats1 from '@/assets/index/seats-1.png';
import worksSeats2 from '@/assets/index/seats-2.png';
import worksSeats3 from '@/assets/index/seats-3.png';
import worksSteering1 from '@/assets/index/steering-1.png';
import worksSteering2 from '@/assets/index/steering-2.png';
import worksSteering3 from '@/assets/index/steering-3.png';
import worksRoof1 from '@/assets/index/roof-1.png';
import worksRoof2 from '@/assets/index/roof-2.png';
import worksRoof3 from '@/assets/index/roof-3.png';
import worksDashboard1 from '@/assets/index/dashboard-1.png';
import worksDashboard2 from '@/assets/index/dashboard-2.png';
import worksDashboard3 from '@/assets/index/dashboard-3.png';

const latestWorks = [
  { image: worksSeats1, alt: 'Car leather seat rewrap completed at Five Star Auto Leather' },
  { image: worksSeats2, alt: 'Car leather seat rewrap completed at Five Star Auto Leather' },
  { image: worksSeats3, alt: 'Car leather seat rewrap completed at Five Star Auto Leather' },
  {
    image: worksSteering1,
    alt: 'Leather steering wheel rewrap completed at Five Star Auto Leather',
  },
  {
    image: worksSteering2,
    alt: 'Leather steering wheel rewrap completed at Five Star Auto Leather',
  },
  {
    image: worksSteering3,
    alt: 'Leather steering wheel rewrap completed at Five Star Auto Leather',
  },
  { image: worksRoof1, alt: 'Car roof lining repair completed at Five Star Auto Leather' },
  { image: worksRoof2, alt: 'Car roof lining repair completed at Five Star Auto Leather' },
  { image: worksRoof3, alt: 'Car roof lining repair completed at Five Star Auto Leather' },
  { image: worksDashboard1, alt: 'Car dashboard repair completed at Five Star Auto Leather' },
  { image: worksDashboard2, alt: 'Car dashboard repair completed at Five Star Auto Leather' },
  { image: worksDashboard3, alt: 'Car dashboard repair completed at Five Star Auto Leather' },
];

const latestWorkPhotos = await Promise.all(
  latestWorks.map(async ({ image, alt }) => {
    const optimized = await getImage({ src: image, width: 800, format: 'webp' });
    return {
      src: optimized.src,
      width: optimized.attributes.width,
      height: optimized.attributes.height,
      alt,
    };
  }),
);

const processedBusinessInNumbersImage = await getImage({
  src: businessInNumbersImage,
  format: 'webp',
  quality: 90,
});

const whatWeDoItems = [
  {
    title: 'Car Leather Seat Rewrap',
    description:
      'Transform your car upholstery with a full leather rewrap, or fix tears and worn areas with targeted repairs.',
    imageUrl: upholsteryImage,
    imageAlt: 'Black leather car seat with diamond stitching and orange trim',
  },
  {
    title: 'Steering Wheel Rewrap',
    description:
      'Restore grip, comfort and driving feel with a premium leather steering wheel wrap.',
    imageUrl: steeringImage,
    imageAlt: 'Craftsperson hand-stitching a black leather steering wheel wrap',
  },
  {
    title: 'Car Roof Lining Repair',
    description: 'Restore sagging headliners with a clean, durable roof lining rewrap.',
    imageUrl: roofLiningImage,
    imageAlt: 'Craftsperson trimming grey fabric for a car roof lining',
  },
  {
    title: 'Dashboard & Door Panel Repair',
    description:
      'Repair cracked, peeling, faded or sun-damaged dashboards and door panels for a clean, restored finish.',
    imageUrl: dashboardImage,
    imageAlt: 'Car dashboard wrapped in grey suede-like fabric with red stitching',
  },
];

const businessStats = [
  {
    statistic: '20',
    description: 'years in business',
  },
  {
    statistic: '21',
    description: 'experts working',
  },
  {
    statistic: '100%',
    description: 'satisfied customers',
  },
];

const whyReasons = [
  'Obsessed with our craft',
  'Bold and creative in every design',
  'Driven by quality and top-tier service',
  'Trusted to deliver nothing less than the best for your ride',
];
---

<BaseLayout>
  <Fragment slot="head">
    <title>Car Upholstery & Leather Seat Repair Singapore | Five Star Auto Leather</title>
    <meta
      name="description"
      content="Car upholstery, leather seat repair, and auto interior restoration in Singapore. With 20 years of expertise in Singapore, we redefined automotive interiors."
    />
  </Fragment>

  <!-- Hero Banner -->
  <section class="grid grid-cols-1 sm:grid-cols-2">
    <div class="order-2 sm:order-1">
      <Image
        src={seatImage}
        alt="Car interior with seats in orange and black wrap"
        loading="eager"
        fetchpriority="high"
        widths={[640, 1280]}
        sizes="(max-width: 640px) 100vw, 50vw"
        class="h-full w-full bg-black object-cover"
      />
    </div>

    <div class="order-1 flex items-center justify-center bg-black px-4 py-8 sm:order-2 sm:px-16">
      <div
        class="title-slide-up flex h-full flex-col items-center justify-center text-center sm:items-start sm:text-left"
      >
        <h2 class="text-4xl text-white">Five Star Auto Leather</h2>

        <h1 class="mt-2 text-white" style={{ fontFamily: 'var(--font-sans)' }}>
          Car Upholstery, Leather Seat Repair & Custom Auto Interiors in Singapore | Five Star
          Service since 2005
        </h1>

        <a
          href="/contact-us"
          class="mt-8 inline-block w-36 rounded bg-red-700 px-4 py-2 text-center text-sm font-medium text-white transition-colors hover:bg-red-600"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="mx-auto flex w-full max-w-7xl flex-col items-center gap-8 px-4 py-8 sm:px-6">
    <div class="text-center">
      <h2 class="text-2xl">What We Do</h2>
      <p class="mt-2">
        From car interior repair to full leather refits, we handle every part of your car's interior
        in-house at our Singapore workshop.
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        whatWeDoItems.map((item) => (
          <div class="flex flex-col items-center">
            <Image
              src={item.imageUrl}
              alt={item.imageAlt}
              loading="lazy"
              widths={[350, 700]}
              sizes="350px"
              class="h-auto w-full max-w-[350px] rounded-lg object-cover"
            />
            <h3 class="mt-4 text-center text-xl font-bold">{item.title}</h3>
            <p class="mt-2 text-center">{item.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Business In Numbers -->
  <section
    class="relative bg-cover bg-center bg-no-repeat sm:bg-fixed"
    style={`background-image: url(${processedBusinessInNumbersImage.src})`}
  >
    <!-- Overlay -->
    <div class="absolute inset-0 z-0 bg-black/70"></div>

    <!-- Content -->
    <div class="relative z-10 container mx-auto max-w-7xl px-4 py-14 text-center sm:px-6">
      <div class="flex w-full flex-col items-center gap-8">
        <h2 class="text-2xl text-white">Our Business in Numbers</h2>

        <div class="grid w-full grid-cols-3 gap-3">
          {
            businessStats.map((item) => (
              <div class="flex flex-col items-center">
                <p class="text-3xl font-bold text-white sm:text-4xl">{item.statistic}</p>
                <p class="mt-2 text-white">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Why You'll Love Us -->
  <section class="grid grid-cols-1 sm:grid-cols-12">
    <div class="order-2 sm:order-1 sm:col-span-5">
      <Image
        src={vanImage}
        alt="Five Star Auto Leather van"
        loading="lazy"
        widths={[640, 1280]}
        sizes="(max-width: 640px) 100vw, 50vw"
        class="h-full w-full object-cover"
      />
    </div>

    <div
      class="order-1 flex h-full flex-col justify-center px-4 py-8 sm:order-2 sm:col-span-7 sm:px-6 md:px-20"
    >
      <h2 class="mb-8 text-center text-2xl sm:text-left">Why Choose Five Star Auto Leather?</h2>
      <p class="mb-2">
        We're all about passion, precision, and that perfect finish. Drop by and see why our team
        is:
      </p>
      <ul class="space-y-2">
        {
          whyReasons.map((reason) => (
            <li class="flex items-center gap-2">
              <Icon
                name="mdi:checkbox-marked-circle-outline"
                class="h-4 w-4 shrink-0 text-red-600"
              />
              <span>{reason}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Our Latest Works -->
  <section class="mx-auto flex w-full max-w-7xl flex-col items-center gap-8 px-4 py-8 sm:px-6">
    <div class="text-center">
      <h2 class="text-2xl">Our Latest Works</h2>
      <p class="mt-2">
        See our recent car upholstery, dashboard, roof lining and steering wheel work, all completed
        in-house at our Singapore workshop.
      </p>
    </div>

    <div class="w-full">
      <PhotoCarousel photos={latestWorkPhotos} client:visible />
    </div>
  </section>

  <!-- Get a Quote Now -->
  <section class="grid grid-cols-1 bg-black text-white sm:grid-cols-2">
    <div
      class="flex h-full flex-col items-center justify-center px-4 py-8 text-center sm:items-start sm:px-6 sm:text-left md:px-20"
    >
      <h2 class="text-2xl">Get a Quote Now!</h2>
      <p class="mt-8">
        Ready to refresh your car interior? Bring your car to Five Star Auto Leather for a free
        assessment and quotation.
      </p>
      <p class="mt-2">
        Full upholstery, partial seat repairs, steering wheel wraps, roof linings, and dashboards
        all done in our Singapore workshop.
      </p>
      <a
        href="/contact-us"
        class="mt-8 inline-block w-36 rounded bg-red-700 px-4 py-2 text-center text-sm font-medium text-white transition-colors hover:bg-red-600"
      >
        Get in Touch
      </a>
    </div>

    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.6660102489027!2d103.8690919!3d1.3770706000000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31da1658b06d3b7d%3A0xbb4992fe537bc610!2sFive%20Star%20Auto%20Leather!5e0!3m2!1sen!2ssg!4v1766728446154!5m2!1sen!2ssg"
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="min-h-[400px] w-full"></iframe>
  </section>
</BaseLayout>

<style>
  h2 {
    font-family: 'RacingSansOne', var(--font-sans);
  }
</style>
