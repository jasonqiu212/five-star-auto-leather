---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import seatImage from '@/assets/seat.png';
import customizationImage from '@/assets/customization.png';
import repairImage from '@/assets/repair.jpg';
import upholsteryImage from '@/assets/upholstery.jpg';
import businessInNumbersImage from '@/assets/business-in-numbers.jpg';
import vanImage from '@/assets/van.jpg';
import steeringRewrap from '@/assets/home-steering-rewrap.webp';
import roofLining from '@/assets/home-roof-lining.webp';
import dashboardRestore from '@/assets/home-dashboard-restore.webp';
import homepageMidImage from '@/assets/homepage-mid-image.webp';
import worksRoof1 from '@/assets/home-latest-roof-lining-1.webp';
import worksRoof2 from '@/assets/home-latest-roof-lining-2.webp';
import worksRoof3 from '@/assets/home-latest-roof-lining-3.webp';
import worksRoof4 from '@/assets/home-latest-roof-lining-4.webp';
import worksRoof5 from '@/assets/home-latest-roof-lining-5.webp';
import worksDashboard1 from '@/assets/home-dashboard-repair-1.webp';
import worksDashboard2 from '@/assets/home-dashboard-repair-2.webp';
import worksDashboard3 from '@/assets/home-dashboard-repair-3.webp';
import worksDashboard4 from '@/assets/home-dashboard-repair-4.webp';
import worksDashboard5 from '@/assets/home-dashboard-repair-5.webp';
import worksSteering1 from '@/assets/home-steering-1.webp';
import worksSteering2 from '@/assets/home-steering-2.webp';
import worksSteering3 from '@/assets/home-steering-3.webp';
import worksSteering4 from '@/assets/home-steering-4.webp';
import worksSteering5 from '@/assets/home-steering-5.webp';
import worksCarSeat1 from '@/assets/home-car-seat-1.webp';
import worksCarSeat2 from '@/assets/home-car-seat-2.webp';
import worksCarSeat3 from '@/assets/home-car-seat-3.webp';
import worksCarSeat4 from '@/assets/home-car-seat-4.webp';
import worksCarSeat5 from '@/assets/home-car-seat-5.webp';

const processedBusinessInNumbersImage = await getImage({
  src: businessInNumbersImage,
  format: 'webp',
  quality: 90,
});

const whatWeDoItems = [
  {
    title: 'Car Seat Upholstery',
    description:
      'Transform your car upholstery with a full leather rewrap, or fix tears and worn areas with targeted repairs.',
    imageUrl: upholsteryImage,
    imageAlt: 'Close-up of automotive leather upholstery',
  },
  {
    title: 'Steering Wheel Rewrap',
    description:
      'Restore grip, comfort and driving feel with a premium leather steering wheel wrap.',
    imageUrl: steeringRewrap,
    imageAlt: 'Leathers used in car seat upholstery',
  },
  {
    title: 'Roof Lining Rewrap',
    description: 'Restore sagging headliners with a clean, durable roof lining rewrap.',
    imageUrl: roofLining,
    imageAlt: 'Sewing machine used in creating car leather seats',
  },
  {
    title: 'Dashboard & Door Panel Repair',
    description:
      'Repair cracked, peeling, faded or sun-damaged dashboards and door panels for a clean, restored finish.',
    imageUrl: dashboardRestore,
    imageAlt: 'Dashboard',
  },
];

const businessStats = [
  {
    statistic: '20',
    description: 'years in business',
  },
  {
    statistic: '21',
    description: 'experts working',
  },
  {
    statistic: '100%',
    description: 'satisfied customers',
  },
];

const whyReasons = [
  'Obsessed with our craft',
  'Bold and creative in every design',
  'Driven by quality and top-tier service',
  'Trusted to deliver nothing less than the best for your ride',
];
---

<BaseLayout>
  <Fragment slot="head">
    <title>Car Upholstery & Leather Seat Repair Singapore | Five Star Auto Leather</title>
    <meta
      name="description"
      content="Car upholstery, leather seat repair, and auto interior restoration in Singapore. With 20 years of expertise in Singapore, we redefined automotive interiors."
    />
  </Fragment>

  <!-- Hero Banner -->
  <section class="grid grid-cols-1 sm:grid-cols-2">
    <div class="order-2 sm:order-1">
      <Image
        src={seatImage}
        alt="Car interior with seats in orange and black wrap"
        loading="eager"
        fetchpriority="high"
        widths={[640, 1280]}
        sizes="(max-width: 640px) 100vw, 50vw"
        class="h-full w-full bg-black object-cover"
      />
    </div>

    <div class="order-1 flex items-center justify-center bg-black px-4 py-8 sm:order-2 sm:px-16">
      <div
        class="title-slide-up flex h-full flex-col items-center justify-center text-center sm:items-start sm:text-left"
      >
        <h2 class="text-4xl text-white">Five Star Auto Leather</h2>

        <h1 class="mt-2 text-white" style={{ fontFamily: 'var(--font-sans)' }}>
          Car Upholstery, Leather Seat Repair & Custom Auto Interiors in Singapore | Five Star
          Service since 2005
        </h1>

        <a
          href="/contact-us"
          class="mt-8 inline-block w-36 rounded bg-red-700 px-4 py-2 text-center text-sm font-medium text-white transition-colors hover:bg-red-600"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="mx-auto flex w-full max-w-7xl flex-col items-center gap-8 px-4 py-8 sm:px-6">
    <div>
      <h2 class="text-center text-2xl">What We Do</h2>
      <p class="mt-2 text-center">
        From car interior repair to full leather refits, we handle every part of your car's interior
        in-house at our Singapore workshop.
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        whatWeDoItems.map((item) => (
          <div class="flex flex-col items-center">
            <Image
              src={item.imageUrl}
              alt={item.imageAlt}
              loading="lazy"
              widths={[350, 700]}
              sizes="350px"
              class="h-auto w-full max-w-[350px] rounded-lg object-cover"
            />
            <h3 class="mt-4 text-center text-xl font-bold">{item.title}</h3>
            <p class="mt-2 text-center">{item.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Business In Numbers -->
  <section
    class="relative bg-cover bg-center bg-no-repeat sm:bg-fixed"
    style={`background-image: url(${processedBusinessInNumbersImage.src})`}
  >
    <!-- Overlay -->
    <div class="absolute inset-0 z-0 bg-black/70"></div>

    <!-- Content -->
    <div class="relative z-10 container mx-auto max-w-7xl px-4 py-14 text-center sm:px-6">
      <div class="flex w-full flex-col items-center gap-8">
        <h2 class="text-2xl text-white">Our Business in Numbers</h2>

        <div class="grid w-full grid-cols-3 gap-3">
          {
            businessStats.map((item) => (
              <div class="flex flex-col items-center">
                <p class="text-3xl font-bold text-white sm:text-4xl">{item.statistic}</p>
                <p class="mt-2 text-white">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Why You'll Love Us -->
  <section class="grid grid-cols-1 sm:grid-cols-12">
    <div class="order-2 sm:order-1 sm:col-span-5">
      <Image
        src={vanImage}
        alt="Five Star Auto Leather van"
        loading="lazy"
        widths={[640, 1280]}
        sizes="(max-width: 640px) 100vw, 50vw"
        class="h-full w-full object-cover"
      />
    </div>

    <div
      class="order-1 flex h-full flex-col justify-center px-4 py-8 sm:order-2 sm:col-span-7 sm:px-6 md:px-20"
    >
      <h2 class="mb-8 text-center text-2xl sm:text-left">Why Choose Five Star Auto Leather?</h2>
      <p class="mb-2">
        We're all about passion, precision, and that perfect finish. Drop by and see why our team
        is:
      </p>
      <ul class="space-y-2">
        {
          whyReasons.map((reason) => (
            <li class="flex items-center gap-2">
              <Icon
                name="mdi:checkbox-marked-circle-outline"
                class="h-4 w-4 shrink-0 text-red-600"
              />
              <span>{reason}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Get a Quote Now -->
  <section class="grid grid-cols-1 sm:grid-cols-2">
    <div class="flex h-full flex-col justify-center px-4 py-8 sm:px-6 md:px-20">
      <h2 class="mb-6 text-center text-2xl sm:text-left">Get a Quote Now</h2>
      <p class="mb-6">
        Ready to refresh your car interior? Bring your car to Five Star Auto Leather for a free
        assessment and quotation.
      </p>
      <a
        href="/contact-us"
        class="inline-block w-36 rounded bg-red-700 px-4 py-2 text-center text-sm font-medium text-white transition-colors hover:bg-red-600"
      >
        Get in Touch
      </a>
    </div>

    <div class="px-4 sm:py-4">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.6660102489027!2d103.8690919!3d1.3770706000000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31da1658b06d3b7d%3A0xbb4992fe537bc610!2sFive%20Star%20Auto%20Leather!5e0!3m2!1sen!2ssg!4v1766728446154!5m2!1sen!2ssg"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="min-h-[400px] w-full rounded-lg"></iframe>
    </div>
  </section>

  <section class="container mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <div class="flex w-full flex-col items-center justify-center gap-4">
      <h2 class="mb-0 text-center text-2xl font-bold">Our Latest Works</h2>
      <p class="mb-6 text-center">
        See our recent car upholstery, dashboard, roof lining and steering wheel work, all completed
        in-house at our Singapore workshop.
      </p>

      <h3 class="mb-0 text-left text-xl font-bold">Car Roof Lining Repair</h3>
      <p class="mb-2 text-center">
        Car roof lining repair restores sagging or peeling headliners back to a clean, factory-fresh
        finish.
      </p>
      <div class="grid w-full grid-cols-3 gap-3">
        <div class="order-1">
          <Image
            src={worksRoof1}
            alt="BMW 420i cabin with headliner converted from original beige to plush black velvet"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-2">
          <Image
            src={worksRoof2}
            alt="Mercedes A180 fitted with a custom starlight headliner featuring fibre-optic LEDs above two-tone red and black sports seats"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-3">
          <Image
            src={worksRoof3}
            alt="Mitsubishi Evolution interior with black velvet roof panel and matching pillars, paired with black Recaro sports seats and blue stitching"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-4">
          <Image
            src={worksRoof4}
            alt="Toyota Hiace Commuter cabin with newly refitted white roof panel around the ceiling air-con vents and drop-down monitor"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-5">
          <Image
            src={worksRoof5}
            alt="Subaru Forester with refreshed roof panel and sun visors in a clean grey finish above two-tone red and black seats with Forester embroidery"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
      </div>

      <h3 class="mt-10 mb-0 text-left text-xl font-bold">Car Dashboard Leather Repair</h3>
      <p class="mb-2 text-center">
        Car dashboard leather repair renews cracked or sun-damaged dashboards with a fresh wrap that
        matches the rest of the cabin.
      </p>
      <div class="grid w-full grid-cols-3 gap-3">
        <div class="order-1">
          <Image
            src={worksDashboard1}
            alt="Honda Odyssey dashboard rewrapped in rich burgundy leather with matching gear surround and vents, paired with a black upper dash and infotainment screen"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover object-top"
          />
        </div>
        <div class="order-2">
          <Image
            src={worksDashboard2}
            alt="Hyundai i45 dashboard refinished with a smooth black PVC upper section and beige lower panel, giving the cabin a clean two-tone contrast"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-3">
          <Image
            src={worksDashboard3}
            alt="Honda Stepwagon Spada dashboard finished in two-tone black and blue with a wrapped instrument hood and matching accent on the steering wheel"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-4">
          <Image
            src={worksDashboard4}
            alt="Lexus IS250 cabin with dashboard rewrapped in smooth black PVC above beige door trims and matching perforated leather seats"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-5">
          <Image
            src={worksDashboard5}
            alt="Toyota Corolla Cross interior with a caramel dashboard rewrap flowing into matching front seat upholstery and contrast stitching detail"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
      </div>

      <h3 class="mt-10 mb-0 text-left text-xl font-bold">Steering Wheel Leather Wrap</h3>
      <p class="mb-2 text-center">
        Steering wheel leather wrap gives one of the most touched surfaces in the car a completely
        new feel with hand-stitched precision.
      </p>
      <div class="grid w-full grid-cols-3 gap-3">
        <div class="order-1">
          <Image
            src={worksSteering1}
            alt="Lexus IS250 steering wheel finished in two-tone black leather with faux carbon fibre accents on the grip sides"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover object-top"
          />
        </div>
        <div class="order-2">
          <Image
            src={worksSteering2}
            alt="Mazda MX5 steering wheel refinished in smooth black leather"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-3">
          <Image
            src={worksSteering3}
            alt="Alternate angle of Mazda MX5 steering wheel refresh in black leather"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-4">
          <Image
            src={worksSteering4}
            alt="Mini S steering wheel finished in two-tone Winter Snow and black with perforated grip sections"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-5">
          <Image
            src={worksSteering5}
            alt="VW ID Buzz steering wheel refinished in smooth leather"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
      </div>

      <h3 class="mt-10 mb-0 text-left text-xl font-bold">Car Seat Leather Repair</h3>
      <p class="mb-2 text-center">
        Car seat leather repair restores worn seats or transforms them with a full custom rewrap in
        your chosen material and colour.
      </p>
      <div class="grid w-full grid-cols-3 gap-3">
        <div class="order-1">
          <Image
            src={worksCarSeat1}
            alt="Lexus RX300 rear bench rewrapped in Caramel with perforated inserts"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover object-top"
          />
        </div>
        <div class="order-2">
          <Image
            src={worksCarSeat2}
            alt="Mercedes A35 front seat rewrapped in two-tone Onyx black and Oxford Navy with vertical centre channel"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-3">
          <Image
            src={worksCarSeat3}
            alt="Close-up of BMW 640i seat rewrapped in full-grain Midnight black and Alabaster"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-4">
          <Image
            src={worksCarSeat4}
            alt="Close-up of Mazda CX5 seat rewrap in full-grain Caramel leather"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
        <div class="order-5">
          <Image
            src={worksCarSeat5}
            alt="Close-up of Mercedes C200 seat rewrap in premium smooth-grain Merlot leather"
            loading="lazy"
            widths={[640, 1280]}
            sizes="(max-width: 640px) 100vw, 50vw"
            class="max-h-[400px] w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="w-full bg-black px-4 py-8 sm:px-6">
    <div class="container mx-auto flex w-full flex-col items-center justify-center gap-2">
      <h2 class="mb-0 text-2xl font-bold text-white">Get a Quote Now!</h2>
      <p class="text-white">
        Ready to refresh your car interior? Bring your car to Five Star Auto Leather for a free
        assessment and quotation.
      </p>
      <p class="text-white">
        Full upholstery, partial seat repairs, steering wheel wraps, roof linings, and dashboards
        all done in our Singapore workshop.
      </p>
      <div class="mt-8 flex w-full items-center justify-center">
        <p class="font-bold text-white">
          Call us: <a class="text-white" href="tel:+6591729570">9172 9570</a> / <a
            class="text-white"
            href="tel:+6587909677">8790 9677</a
          >
        </p>
        <a
          href="https://www.google.com/maps?cid=13495479379412370960"
          class="ml-6 inline-block w-50 rounded bg-red-700 px-4 py-2 text-center text-sm font-medium text-white transition-colors hover:bg-red-600"
        >
          Find Us
        </a>
      </div>
    </div>
  </section>

  <iframe
    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.6660102489027!2d103.8690919!3d1.3770706000000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31da1658b06d3b7d%3A0xbb4992fe537bc610!2sFive%20Star%20Auto%20Leather!5e0!3m2!1sen!2sph!4v1782371450352!5m2!1sen!2sph"
    width="100%"
    height="400"
    style="border:0;"
    allowfullscreen=""
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"></iframe>
</BaseLayout>

<style>
  h2 {
    font-family: 'RacingSansOne', var(--font-sans);
  }
</style>
