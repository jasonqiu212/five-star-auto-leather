---
import Logo from '@/components/Logo.astro';
import { Icon } from 'astro-icon/components';
import '@/styles/global.css';

const links = [
  { key: 'our-story', link: '/our-story', label: 'Our Story' },
  {
    key: 'services',
    label: 'Services',
    items: [
      {
        key: 'car-leather-seat-interior-repair',
        link: '/car-leather-seat-interior-repair',
        label: 'Car Seat Interior Repair',
      },
      {
        key: 'car-steering-wheel-wrap',
        link: '/car-steering-wheel-wrap',
        label: 'Steering Wheel Wrap',
      },
      { key: 'car-roof-lining', link: '/car-roof-lining', label: 'Car Roof Lining' },
      {
        key: 'car-dashboard-leather-repair',
        link: '/car-dashboard-leather-repair',
        label: 'Dashboard Leather Repair',
      },
    ],
  },
  //   { key: 'portfolio', link: '/portfolio', label: 'Portfolio' },
  { key: 'faq', link: '/faq', label: 'FAQ' },
  { key: 'blog', link: '/blog', label: 'Blog' },
  { key: 'contact-us', link: '/contact-us', label: 'Contact Us' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 h-16 bg-white/70 shadow-sm backdrop-blur-md">
  <div class="container mx-auto flex h-full max-w-7xl items-center px-4 sm:px-6">
    <div class="flex w-full items-center justify-between">
      <Logo />

      <nav class="hidden items-center gap-3 lg:flex">
        {
          links.map((link) =>
            link.items ? (
              <details class="group relative">
                <summary
                  class:list={[
                    'flex cursor-pointer list-none items-center gap-1 text-sm transition-colors hover:text-gray-900',
                    link.items.some((item) => currentPath === item.link)
                      ? 'font-medium text-gray-900'
                      : 'text-gray-600',
                  ]}
                >
                  {link.label}
                  <Icon
                    name="mdi:chevron-down"
                    aria-hidden="true"
                    class="h-4 w-4 transition-transform group-open:rotate-180"
                  />
                </summary>

                <div class="absolute top-full right-0 z-10 mt-3 min-w-56 rounded-md bg-white p-2 shadow-lg ring-1 ring-black/5">
                  {link.items.map((item) => (
                    <a
                      href={item.link}
                      class:list={[
                        'block rounded px-3 py-2 text-sm transition-colors hover:bg-gray-100 hover:text-gray-900',
                        currentPath === item.link ? 'font-medium text-gray-900' : 'text-gray-600',
                      ]}
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={link.link}
                class:list={[
                  'text-sm transition-colors hover:text-gray-900',
                  currentPath === link.link ? 'font-medium text-gray-900' : 'text-gray-600',
                ]}
              >
                {link.label}
              </a>
            ),
          )
        }
      </nav>

      <details class="group relative lg:hidden">
        <summary class="flex cursor-pointer list-none items-center text-gray-700">
          <span class="sr-only">Open navigation menu</span>
          <Icon name="mdi:menu" aria-hidden="true" class="h-7 w-7" />
        </summary>

        <nav
          class="absolute top-full right-0 z-10 mt-3 w-[calc(100vw-2rem)] max-w-72 rounded-md bg-white p-2 shadow-lg ring-1 ring-black/5"
        >
          {
            links.map((link) =>
              link.items ? (
                <details>
                  <summary
                    class:list={[
                      'flex cursor-pointer list-none items-center justify-between rounded px-3 py-2 text-sm transition-colors hover:bg-gray-100 hover:text-gray-900',
                      link.items.some((item) => currentPath === item.link)
                        ? 'font-medium text-gray-900'
                        : 'text-gray-600',
                    ]}
                  >
                    {link.label}
                    <Icon name="mdi:chevron-down" aria-hidden="true" class="h-4 w-4" />
                  </summary>

                  <div class="pl-3">
                    {link.items.map((item) => (
                      <a
                        href={item.link}
                        class:list={[
                          'block rounded px-3 py-2 text-sm transition-colors hover:bg-gray-100 hover:text-gray-900',
                          currentPath === item.link ? 'font-medium text-gray-900' : 'text-gray-600',
                        ]}
                      >
                        {item.label}
                      </a>
                    ))}
                  </div>
                </details>
              ) : (
                <a
                  href={link.link}
                  class:list={[
                    'block rounded px-3 py-2 text-sm transition-colors hover:bg-gray-100 hover:text-gray-900',
                    currentPath === link.link ? 'font-medium text-gray-900' : 'text-gray-600',
                  ]}
                >
                  {link.label}
                </a>
              ),
            )
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;

    if (!(target instanceof Node)) return;

    document.querySelectorAll('header details[open]').forEach((menu) => {
      if (!menu.contains(target)) {
        menu.removeAttribute('open');
      }
    });
  });
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
