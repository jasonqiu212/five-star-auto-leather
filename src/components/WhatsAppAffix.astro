---
const accounts = [
  {
    name: 'Alvin',
    number: '+65 9172 9570',
    whatsappUrl: 'https://api.whatsapp.com/send?phone=6591729570',
  },
  {
    name: 'Joy',
    number: '+65 8790 9677',
    whatsappUrl: 'https://api.whatsapp.com/send?phone=6587909677',
  },
];
---

<div id="wa-affix" class="fixed right-4 bottom-4 z-1000">
  <div
    id="wa-hint"
    class="absolute right-14 bottom-2 rounded-lg bg-white px-3 py-2 text-sm whitespace-nowrap shadow-md/20"
  >
    Need help? Chat with us!
  </div>

  <button
    id="wa-btn"
    class="relative flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border-none bg-green-500 p-4 text-white shadow-md/20 transition-all duration-300 hover:bg-green-600 hover:shadow-lg/20"
    aria-label="Chat with us on WhatsApp"
    type="button"
  >
    <!-- mdi:whatsapp -->
    <svg
      class="wa-icon absolute h-7 w-7"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.71 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7 8.5 7 9.71C7 10.93 7.89 12.1 8 12.27C8.14 12.44 9.76 14.94 12.25 16C12.84 16.27 13.3 16.42 13.66 16.53C14.25 16.72 14.79 16.69 15.22 16.63C15.7 16.56 16.68 16.03 16.89 15.45C17.1 14.87 17.1 14.37 17.04 14.27C16.97 14.17 16.81 14.1 16.56 13.98C16.31 13.86 15.09 13.26 14.87 13.18C14.64 13.1 14.5 13.06 14.31 13.31C14.13 13.55 13.67 14.1 13.53 14.27C13.38 14.44 13.24 14.46 13 14.34C12.75 14.21 11.96 13.95 11.02 13.11C10.29 12.45 9.8 11.64 9.66 11.39C9.5 11.15 9.65 11 9.77 10.89C9.88 10.78 10 10.6 10.15 10.45C10.28 10.31 10.32 10.2 10.4 10.04C10.5 9.87 10.45 9.73 10.39 9.61C10.32 9.5 9.84 8.27 9.63 7.79C9.43 7.31 9.23 7.38 9.07 7.37L8.53 7.33Z"
      ></path>
    </svg>
    <!-- mdi:close -->
    <svg
      class="close-icon absolute h-7 w-7"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
      ></path>
    </svg>
  </button>

  <div
    id="wa-popover"
    class="whatsapp-popover-slide-up absolute right-0 bottom-16 hidden min-w-[250px] rounded-lg bg-white p-4 shadow-xl/25"
  >
    <h3 class="mb-1">Chat with us on WhatsApp!</h3>
    <div class="flex flex-col gap-1">
      {
        accounts.map((account) => (
          <a
            href={account.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 rounded-lg p-2 no-underline transition-colors hover:bg-gray-100"
          >
            <svg
              class="h-8 w-8 text-green-500"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.71 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7 8.5 7 9.71C7 10.93 7.89 12.1 8 12.27C8.14 12.44 9.76 14.94 12.25 16C12.84 16.27 13.3 16.42 13.66 16.53C14.25 16.72 14.79 16.69 15.22 16.63C15.7 16.56 16.68 16.03 16.89 15.45C17.1 14.87 17.1 14.37 17.04 14.27C16.97 14.17 16.81 14.1 16.56 13.98C16.31 13.86 15.09 13.26 14.87 13.18C14.64 13.1 14.5 13.06 14.31 13.31C14.13 13.55 13.67 14.1 13.53 14.27C13.38 14.44 13.24 14.46 13 14.34C12.75 14.21 11.96 13.95 11.02 13.11C10.29 12.45 9.8 11.64 9.66 11.39C9.5 11.15 9.65 11 9.77 10.89C9.88 10.78 10 10.6 10.15 10.45C10.28 10.31 10.32 10.2 10.4 10.04C10.5 9.87 10.45 9.73 10.39 9.61C10.32 9.5 9.84 8.27 9.63 7.79C9.43 7.31 9.23 7.38 9.07 7.37L8.53 7.33Z" />
            </svg>
            <div class="flex flex-col gap-1">
              <p class="font-medium">{account.name}</p>
              <p class="text-sm text-gray-600">{account.number}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .wa-icon,
  .close-icon {
    transition: all 300ms;
  }

  .wa-icon {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }

  .close-icon {
    transform: scale(0) rotate(-90deg);
    opacity: 0;
  }

  #wa-affix[data-open] .wa-icon {
    transform: scale(0) rotate(90deg);
    opacity: 0;
  }

  #wa-affix[data-open] .close-icon {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
</style>

<script>
  const affix = document.getElementById('wa-affix')!;
  const btn = document.getElementById('wa-btn')!;
  const popover = document.getElementById('wa-popover')!;
  const hint = document.getElementById('wa-hint');

  function openPopover() {
    affix.setAttribute('data-open', '');
    popover.classList.remove('hidden');
  }

  function closePopover() {
    affix.removeAttribute('data-open');
    popover.classList.add('hidden');
  }

  btn.addEventListener('click', () => {
    hint?.remove();
    affix.hasAttribute('data-open') ? closePopover() : openPopover();
  });

  popover.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closePopover);
  });

  document.addEventListener('click', (e) => {
    if (affix.hasAttribute('data-open') && !affix.contains(e.target as Node)) {
      closePopover();
    }
  });
</script>
